<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:label="SellerKeyboard Autofill Test Provider"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <service
            android:name=".DeterministicAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
        <activity
            android:name=".ProviderAttributionActivity"
            android:exported="false" />
        <provider
            android:name=".ProviderTestBridge"
            android:authorities="${applicationId}.test-bridge"
            android:exported="true" />
    </application>
</manifest>
