# Copy to .env.local and fill with the target Convex deployment.
# Do not commit .env.local or any deploy keys.

# Dev deployment used by `bunx convex dev --once --env-file .env.local`.
CONVEX_DEPLOYMENT=dev:your-dev-deployment-name

# Public URL consumed by Android string resources.
CONVEX_URL=https://your-dev-deployment.convex.cloud

# Optional for non-interactive CI/preview deploys only. Treat as a secret.
# CONVEX_DEPLOY_KEY=
